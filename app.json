    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      },
      "package": "com.bnzbuilders.opssuite",
      "versionCode": 1
    }
  }
